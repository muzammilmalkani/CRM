  s.desc = document.getElementById('scm-desc')?.value || s.desc;
  s.probability = +(document.getElementById('scm-prob')?.value || s.probability);
  s.duration = +(document.getElementById('scm-dur')?.value || s.duration);
  s.rotting = +(document.getElementById('scm-rotting')?.value || s.rotting);
  s.inspeq = document.getElementById('scm-inspeq')?.checked;
