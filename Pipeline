<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EquipCRM — Heavy Equipment CRM</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #F5F4F1;
    --surface: #FFFFFF;
    --surface2: #F9F8F6;
    --border: rgba(0,0,0,0.10);
    --border2: rgba(0,0,0,0.18);
    --text: #1A1A18;
    --text2: #5A5A55;
    --text3: #9A9990;
    --accent: #1A4A2E;
    --accent2: #2C7A4B;
    --accent-bg: #E8F5EE;
    --amber: #8B5A00;
    --amber-bg: #FEF3E2;
    --red: #A32D2D;
    --red-bg: #FCEBEB;
    --blue: #185FA5;
    --blue-bg: #E6F1FB;
    --tag-sale: #185FA5; --tag-sale-bg: #E6F1FB;
    --tag-rental: #9D4A00; --tag-rental-bg: #FEF3E2;
    --tag-lease: #6B3B9A; --tag-lease-bg: #EEEDFE;
    --tag-auction: #093B26; --tag-auction-bg: #E1F5EE;
    --nav-w: 0px;
    --topnav-h: 56px;
    --subnav-h: 44px;
    --header-h: 56px;
    --radius: 8px;
    --radius-lg: 12px;
    --shadow: 0 1px 3px rgba(0,0,0,0.07), 0 1px 2px rgba(0,0,0,0.06);
    --shadow-lg: 0 4px 16px rgba(0,0,0,0.12);
  }

  /* ══════════════════════════════════════════════════════
     TOP NAVIGATION — modern app bar
  ══════════════════════════════════════════════════════ */
  .topnav {
    height: var(--topnav-h);
    background: #111910;
    display: flex;
    align-items: center;
    padding: 0 20px;
    gap: 0;
    flex-shrink: 0;
    z-index: 200;
    position: relative;
  }
  .topnav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    margin-right: 28px;
    flex-shrink: 0;
  }
  .topnav-logo-mark {
    width: 30px;
    height: 30px;
    background: linear-gradient(135deg, #2C7A4B 0%, #1A4A2E 100%);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.5px;
    flex-shrink: 0;
  }
  .topnav-wordmark {
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.4px;
  }
  .topnav-wordmark span {
    color: #4CAF78;
  }

  /* Primary nav groups */
  .topnav-groups {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
  }
  .topnav-group {
    position: relative;
  }
  .topnav-group-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 7px;
    border: none;
    background: transparent;
    color: rgba(255,255,255,0.65);
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .topnav-group-btn:hover {
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.95);
  }
  .topnav-group-btn.active {
    background: rgba(44,122,75,0.25);
    color: #5DD68A;
  }
  .topnav-group-btn svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .topnav-chevron {
    width: 12px;
    height: 12px;
    opacity: 0.5;
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  .topnav-group.open .topnav-chevron {
    transform: rotate(180deg);
    opacity: 0.8;
  }

  /* Direct nav links (no dropdown) */
  .topnav-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 7px;
    color: rgba(255,255,255,0.65);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
    text-decoration: none;
    border: none;
    background: transparent;
    font-family: inherit;
  }
  .topnav-link:hover {
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.95);
  }
  .topnav-link.active {
    background: rgba(44,122,75,0.25);
    color: #5DD68A;
  }
  .topnav-link svg { width: 14px; height: 14px; flex-shrink: 0; }
  .topnav-badge {
    background: rgba(255,255,255,0.12);
    border-radius: 20px;
    font-size: 10.5px;
    padding: 1px 6px;
    color: rgba(255,255,255,0.5);
    font-weight: 600;
    margin-left: 1px;
  }
  .topnav-link.active .topnav-badge {
    background: rgba(93,214,138,0.2);
    color: #5DD68A;
  }

  /* Dropdown menus */
  .topnav-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 220px;
    background: #1C2B1F;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 6px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4), 0 2px 8px rgba(0,0,0,0.2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 500;
  }
  .topnav-group.open .topnav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .topnav-dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.1s;
    text-decoration: none;
    color: rgba(255,255,255,0.75);
    font-size: 13px;
    border: none;
    background: transparent;
    font-family: inherit;
    width: 100%;
    text-align: left;
  }
  .topnav-dropdown-item:hover {
    background: rgba(255,255,255,0.07);
    color: #fff;
  }
  .topnav-dropdown-item.active {
    background: rgba(44,122,75,0.3);
    color: #5DD68A;
  }
  .topnav-dropdown-item svg {
    width: 14px; height: 14px;
    flex-shrink: 0;
    opacity: 0.7;
  }
  .topnav-dropdown-item.active svg { opacity: 1; }
  .topnav-dropdown-item-meta {
    flex: 1;
  }
  .topnav-dropdown-item-label {
    font-weight: 500;
    line-height: 1.3;
  }
  .topnav-dropdown-item-sub {
    font-size: 11px;
    color: rgba(255,255,255,0.35);
    margin-top: 1px;
  }
  .topnav-dropdown-item.active .topnav-dropdown-item-sub { color: rgba(93,214,138,0.6); }
  .topnav-dd-badge {
    font-size: 10.5px;
    padding: 1px 6px;
    border-radius: 20px;
    background: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.45);
    font-weight: 600;
    flex-shrink: 0;
  }
  .topnav-dropdown-item.active .topnav-dd-badge {
    background: rgba(93,214,138,0.2);
    color: #5DD68A;
  }
  .topnav-dropdown-sep {
    height: 1px;
    background: rgba(255,255,255,0.07);
    margin: 4px 6px;
  }
  .topnav-dropdown-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: rgba(255,255,255,0.25);
    padding: 8px 12px 4px;
  }

  /* Right side of topnav */
  .topnav-right {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    padding-left: 20px;
  }
  .topnav-search-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 0 12px;
    height: 32px;
    cursor: text;
    transition: all 0.15s;
    min-width: 200px;
  }
  .topnav-search-pill:hover, .topnav-search-pill:focus-within {
    background: rgba(255,255,255,0.11);
    border-color: rgba(255,255,255,0.18);
  }
  .topnav-search-pill input {
    border: none;
    background: transparent;
    outline: none;
    font-family: inherit;
    font-size: 12.5px;
    color: rgba(255,255,255,0.7);
    width: 100%;
  }
  .topnav-search-pill input::placeholder { color: rgba(255,255,255,0.3); }
  .topnav-search-pill svg { color: rgba(255,255,255,0.3); flex-shrink: 0; }
  .topnav-icon-btn {
    width: 32px; height: 32px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.06);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: rgba(255,255,255,0.6);
    transition: all 0.15s;
    position: relative;
    flex-shrink: 0;
  }
  .topnav-icon-btn:hover {
    background: rgba(255,255,255,0.11);
    color: rgba(255,255,255,0.9);
  }
  .topnav-icon-btn svg { width: 15px; height: 15px; }
  .topnav-notif-dot {
    position: absolute; top: 5px; right: 5px;
    width: 7px; height: 7px;
    background: #F87171;
    border-radius: 50%;
    border: 1.5px solid #111910;
  }
  .topnav-avatar {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2C7A4B, #1A4A2E);
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    font-size: 11px; font-weight: 700;
    cursor: pointer;
    border: 1.5px solid rgba(255,255,255,0.15);
    flex-shrink: 0;
    transition: all 0.15s;
  }
  .topnav-avatar:hover { border-color: rgba(255,255,255,0.3); }

  /* Divider between nav groups */
  .topnav-divider {
    width: 1px;
    height: 18px;
    background: rgba(255,255,255,0.1);
    margin: 0 6px;
    flex-shrink: 0;
  }

  /* Sub-nav breadcrumb bar (shows current section) */
  .subnav {
    height: var(--subnav-h);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 28px;
    gap: 0;
    flex-shrink: 0;
    z-index: 100;
  }
  .subnav-crumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--text3);
  }
  .subnav-crumb-sep {
    font-size: 14px;
    color: var(--border2);
    margin: 0 2px;
  }
  .subnav-current {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }
  .subnav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Mobile hamburger */
  .topnav-hamburger {
    display: none;
    width: 32px; height: 32px;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 7px;
    background: rgba(255,255,255,0.06);
    align-items: center; justify-content: center;
    cursor: pointer; color: rgba(255,255,255,0.7);
    margin-left: 8px;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    line-height: 1.5;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* topbar removed — using topnav */

  /* ── MAIN LAYOUT ───────────────────────────────────────────── */
  .app-body {
    display: flex;
    flex: 1;
    overflow: hidden;
    flex-direction: column;
  }
  .app-body-inner {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* sidebar removed — using topnav */

  /* ── MAIN CONTENT ──────────────────────────────────────────── */
  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;
  }

  .page { display: none; flex: 1; flex-direction: column; overflow: hidden; }
  .page.active { display: flex; }

  /* ── PAGE HEADER ───────────────────────────────────────────── */
  .page-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 0 32px;
    flex-shrink: 0;
  }
  .page-header-top {
    display: flex; align-items: center; gap: 12px;
    padding: 20px 0 16px;
  }
  .page-title { font-size: 20px; font-weight: 600; letter-spacing: -0.3px; }
  .page-title-badge {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    font-size: 12px;
    padding: 2px 10px;
    color: var(--text2);
  }
  .page-header-actions { margin-left: auto; display: flex; gap: 8px; }
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 0 14px; height: 34px;
    border-radius: var(--radius);
    font-family: inherit; font-size: 13px; font-weight: 500;
    cursor: pointer; transition: all 0.12s;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .btn:hover { background: var(--bg); }
  .btn-primary {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .btn-primary:hover { background: #163D26; border-color: #163D26; }
  .btn svg { width: 14px; height: 14px; }

  .tabs {
    display: flex; gap: 0;
    border-bottom: 0px;
    margin-bottom: -1px;
  }
  .tab {
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 400;
    color: var(--text2);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.12s;
  }
  .tab:hover { color: var(--text); }
  .tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 500; }

  /* ── KPI CARDS ─────────────────────────────────────────────── */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 24px 32px 16px;
    flex-shrink: 0;
  }
  .kpi-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
  }
  .kpi-label {
    font-size: 12px;
    color: var(--text3);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }
  .kpi-value {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.5px;
    color: var(--text);
    line-height: 1;
    margin-bottom: 6px;
  }
  .kpi-sub {
    font-size: 12px;
    color: var(--text3);
    display: flex; align-items: center; gap: 4px;
  }
  .kpi-delta-up { color: #2C7A4B; }
  .kpi-delta-down { color: var(--red); }

  /* ── FILTER BAR ────────────────────────────────────────────── */
  .filter-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 32px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .filter-chip {
    display: flex; align-items: center; gap: 6px;
    padding: 5px 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 12.5px;
    color: var(--text2);
    cursor: pointer;
    font-family: inherit;
    transition: all 0.12s;
  }
  .filter-chip:hover { background: var(--bg); border-color: var(--border2); }
  .filter-chip svg { width: 12px; height: 12px; color: var(--text3); }
  .filter-right { margin-left: auto; display: flex; gap: 6px; }
  .view-toggle {
    display: flex;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  .view-btn {
    width: 32px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: var(--text3);
    background: none; border: none; font-family: inherit;
    transition: all 0.12s;
  }
  .view-btn.active { background: var(--bg); color: var(--text); }
  .view-btn svg { width: 14px; height: 14px; }

  /* ── TABLE ─────────────────────────────────────────────────── */
  .table-container {
    flex: 1; overflow: auto;
    padding: 16px 32px 24px;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .data-table thead th {
    text-align: left;
    padding: 12px 16px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--surface2);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .data-table thead th:first-child { padding-left: 20px; }
  .data-table tbody tr {
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.1s;
  }
  .data-table tbody tr:last-child { border-bottom: none; }
  .data-table tbody tr:hover { background: var(--bg); }
  .data-table tbody td {
    padding: 14px 16px;
    vertical-align: middle;
    font-size: 13.5px;
  }
  .data-table tbody td:first-child { padding-left: 20px; }
  .deal-name { font-weight: 500; color: var(--text); }
  .deal-account { color: var(--text2); }
  .deal-amount { font-family: 'DM Mono', monospace; font-weight: 500; font-size: 13px; }
  .tag {
    display: inline-flex; align-items: center;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 11.5px;
    font-weight: 500;
  }
  .tag-sale { background: var(--tag-sale-bg); color: var(--tag-sale); }
  .tag-rental { background: var(--tag-rental-bg); color: var(--tag-rental); }
  .tag-lease { background: var(--tag-lease-bg); color: var(--tag-lease); }
  .tag-auction { background: var(--tag-auction-bg); color: var(--tag-auction); }
  .stage-cell { display: flex; align-items: center; gap: 10px; }
  .stage-bar-bg { width: 48px; height: 5px; background: var(--bg); border-radius: 4px; }
  .stage-bar-fill { height: 5px; border-radius: 4px; background: var(--accent2); }
  .stage-label { font-size: 12.5px; color: var(--text2); }
  .health-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 12px; font-weight: 500;
  }
  .health-badge .dot { width: 6px; height: 6px; border-radius: 50%; }
  .health-on-track { background: #EAF3DE; color: #3B6D11; }
  .health-on-track .dot { background: #639922; }
  .health-at-risk { background: var(--amber-bg); color: var(--amber); }
  .health-at-risk .dot { background: #BA7517; }
  .health-critical { background: var(--red-bg); color: var(--red); }
  .health-critical .dot { background: #E24B4A; }
  .date-cell { color: var(--text2); font-size: 13px; }
  .table-footer {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px;
    border-top: 1px solid var(--border);
    background: var(--surface);
    font-size: 12.5px; color: var(--text3);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .pagination { display: flex; gap: 4px; }
  .page-btn {
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    cursor: pointer; font-size: 12px; color: var(--text2);
    font-family: inherit;
  }
  .page-btn:hover { background: var(--bg); }
  .page-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

  /* ── KANBAN ────────────────────────────────────────────────── */
  .kanban-container {
    flex: 1; overflow: auto;
    padding: 20px 32px;
  }
  .kanban-board {
    display: flex; gap: 16px;
    min-width: max-content;
    height: 100%;
    align-items: flex-start;
  }
  .kanban-col {
    width: 300px; flex-shrink: 0;
    display: flex; flex-direction: column;
    gap: 0;
  }
  .kanban-col-header {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    border-bottom: none;
    padding: 12px 14px 10px;
    display: flex; align-items: center; gap: 8px;
    position: relative;
  }
  .kanban-col-accent {
    position: absolute; top: 0; left: 0; right: 0; height: 3px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .kanban-col-title {
    font-size: 13px; font-weight: 600;
    color: var(--text);
  }
  .kanban-col-count {
    font-size: 11px; font-weight: 500;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1px 7px;
    color: var(--text3);
  }
