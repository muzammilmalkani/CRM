function acctDetailTab(tab, el) {
  const tabs = ['overview','deals','machines','jobs','contacts','activity','files'];
  tabs.forEach(t=>{
    const el2 = document.getElementById('acctd-'+t);
    if(el2) el2.style.display = 'none';
  });
  const show = document.getElementById('acctd-'+tab);
  if(show) show.style.display = tab==='overview' ? 'flex' : 'block';
  document.querySelectorAll('#acct-detail-tabs .tab').forEach(t=>t.classList.remove('active'));
  if(el) el.classList.add('active');
  
  // Full tab renders
  const id = window._currentAcctId||'A1';
  if(tab==='activity') renderFullActivity(id);
  if(tab==='deals') renderFullDeals(id);
  if(tab==='contacts') renderFullContacts(id);
  if(tab==='machines') renderFullMachines(id);
  if(tab==='jobs') renderFullJobs(id);
  if(tab==='files') renderFiles(id);
}

