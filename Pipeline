// ===== ACCOUNT CREATION STEPPER =====
let acctStep = 1;
const acctStepCount = 3;
const acctStepNextLabels = ['Next: Contacts →', 'Next: Preferences →', 'Create Account'];

function openCreateAccount() {
  acctStep = 1; renderAcctStep();
  document.getElementById('createAccountModal').classList.add('open');
}
function openCreateContact() {
  document.getElementById('createContactModal').classList.add('open');
}
function acctStepNav(dir) {
  const next = acctStep + dir;
  if(next>=1&&next<=acctStepCount){ acctStep=next; renderAcctStep(); }
  else if(acctStep===acctStepCount&&dir===1){
    document.getElementById('createAccountModal').classList.remove('open');
    setTimeout(()=>alert('Account created! (Prototype)'),100);
  }
}
function renderAcctStep() {
  for(let i=1;i<=acctStepCount;i++){
    const s=document.getElementById('acct-step'+i); if(s) s.style.display=i===acctStep?'block':'none';
    const n=document.getElementById('asn'+i),l=document.getElementById('asl'+i);
    if(n){n.className='step-num '+(i<acctStep?'done':i===acctStep?'active':'pending');n.textContent=i<acctStep?'✓':i;}
    if(l){l.className='step-label'+(i===acctStep?' active':'');}
  }
  const p=document.getElementById('acct-prev-btn'),nx=document.getElementById('acct-next-btn');
  if(p) p.style.display=acctStep>1?'inline-flex':'none';
  if(nx) nx.textContent=acctStepNextLabels[acctStep-1];
}

