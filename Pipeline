function cdTab(tab, el) {
  ['overview','deals','activity','notes'].forEach(t=>{
    const e=document.getElementById('cd-'+t); if(e) e.style.display='none';
  });
  const show=document.getElementById('cd-'+tab);
  if(show) show.style.display=tab==='overview'?'flex':'block';
  document.querySelectorAll('#cd-tabs .tab').forEach(t=>t.classList.remove('active'));
  if(el) el.classList.add('active');
  const id=window._currentContactId||'C1';
  if(tab==='activity') renderContactActivity(id);
  if(tab==='notes') renderContactNotes(id);
  if(tab==='deals') renderContactDeals(id);
}

