function navigate(page, el) {
  // Hide all pages
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const target = document.getElementById('page-' + page);
  if(target) target.classList.add('active');

  // Update topnav active states
  document.querySelectorAll('.topnav-link, .topnav-dropdown-item').forEach(n => n.classList.remove('active'));
  document.querySelectorAll('.topnav-group-btn').forEach(b => b.classList.remove('active'));

  // Mark the clicked item
  if(el) el.classList.add('active');

  // Also activate parent group button if clicking dropdown item
  const meta = PAGE_META[page];
  if(meta) {
    const groupId = 'tng-' + meta.group;
    const groupBtn = document.querySelector(`#${groupId} .topnav-group-btn`);
    if(groupBtn) groupBtn.classList.add('active');
    // Update subnav breadcrumb
    updateSubnav(meta.crumb, page);
  }

  closeAllDropdowns();
}

function updateSubnav(crumb, page) {
  const crumbEl = document.getElementById('subnav-crumb');
  const actionsEl = document.getElementById('subnav-actions');
  if(!crumbEl) return;

  if(crumb && crumb.length >= 2) {
    crumbEl.innerHTML = `
      <span style="color:var(--text3)">${crumb[0]}</span>
      <span class="subnav-crumb-sep">/</span>
      <span class="subnav-current">${crumb[crumb.length-1]}</span>
      ${crumb.length > 2 ? `<span class="subnav-crumb-sep">/</span><span class="subnav-current">${crumb[2]||''}</span>` : ''}
    `;
  }

  // Contextual quick actions per page
  const actions = {
    deals: `<button class="btn btn-primary" style="height:30px;font-size:12px" onclick="openModal()">+ New Deal</button>`,
    accounts: `<button class="btn btn-primary" style="height:30px;font-size:12px" onclick="openCreateAccount()">+ New Account</button>`,
    machines: `<button class="btn btn-primary" style="height:30px;font-size:12px">+ Add Machine</button>`,
    jobs: `<button class="btn btn-primary" style="height:30px;font-size:12px">+ New Job</button>`,
    inspeq: `<button class="btn btn-primary" style="height:30px;font-size:12px" onclick="openModal()">Trigger Inspection</button>`,
    marketplace: `<button class="btn btn-primary" style="height:30px;font-size:12px">Push Machine</button>`,
    pipelines: `<button class="btn btn-primary" style="height:30px;font-size:12px" onclick="openCreatePipeline()">+ New Pipeline</button>`,
  };
  if(actionsEl) actionsEl.innerHTML = actions[page] || '';
}

function toggleDropdown(groupId) {
  const group = document.getElementById(groupId);
  if(!group) return;
  const isOpen = group.classList.contains('open');
  closeAllDropdowns();
  if(!isOpen) group.classList.add('open');
}

function closeAllDropdowns() {
  document.querySelectorAll('.topnav-group.open').forEach(g => g.classList.remove('open'));
}

// Close dropdowns on outside click
document.addEventListener('click', e => {
  if(!e.target.closest('.topnav-group')) closeAllDropdowns();
});
// Keyboard: close on Escape
document.addEventListener('keydown', e => {
  if(e.key === 'Escape') closeAllDropdowns();
});

function toggleMobileMenu() {
  const groups = document.querySelector('.topnav-groups');
  if(groups) groups.style.display = groups.style.display === 'flex' ? 'none' : 'flex';
}




function switchView(view, tabEl) {
  const table = document.getElementById('view-table');
  const kanban = document.getElementById('view-kanban');
  if (view === 'table') {
    if(table) { table.style.display = 'flex'; table.style.flexDirection = 'column'; }
    if(kanban) kanban.style.display = 'none';
  } else {
    if(table) table.style.display = 'none';
    if(kanban) { kanban.style.display = 'flex'; kanban.style.flexDirection = 'column'; }
  }
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  if (tabEl) tabEl.classList.add('active');
}

function openModal() {
  currentStep = 1;
  renderStep();
  document.getElementById('dealModal').classList.add('open');
}
function closeModal() {
  document.getElementById('dealModal').classList.remove('open');
}
document.getElementById('dealModal').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});

function renderStep() {
  for (let i = 1; i <= totalSteps; i++) {
    const stepEl = document.getElementById('step' + i);
    if (stepEl) stepEl.style.display = i === currentStep ? 'block' : 'none';
    const num = document.getElementById('sn' + i);
    const label = document.getElementById('sl' + i);
    if (num) {
      num.className = 'step-num ' + (i < currentStep ? 'done' : i === currentStep ? 'active' : 'pending');
      num.textContent = i < currentStep ? '✓' : i;
    }
    if (label) {
      label.className = 'step-label' + (i === currentStep ? ' active' : '');
    }
  }
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  if (prevBtn) prevBtn.style.display = currentStep > 1 ? 'inline-flex' : 'none';
  if (nextBtn) nextBtn.textContent = stepNextLabels[currentStep - 1];
}

function stepNav(dir) {
  const next = currentStep + dir;
  if (next >= 1 && next <= totalSteps) {
    currentStep = next;
    renderStep();
  } else if (currentStep === totalSteps && dir === 1) {
    closeModal();
    alert('Deal saved! (Prototype: deal would be created in the CRM.)');
  }
}

