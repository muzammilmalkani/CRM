          </div>
        </div>
      </div>
    </div>
  `).join('');
}

function dropStage(targetIdx) {
  if(dragIdx === null || dragIdx === targetIdx) return;
  const moved = editorStages.splice(dragIdx, 1)[0];
  editorStages.splice(targetIdx, 0, moved);
  dragIdx = null;
  if(selectedStageIdx === null) {}
  else if(selectedStageIdx === dragIdx) selectedStageIdx = targetIdx;
  renderEditorStages();
}

function addStageToEditor() {
  const colors = ['#3B82F6','#8B5CF6','#F59E0B','#EF4444','#10B981','#6B7280'];
  editorStages.push({
    id:'s'+Date.now(),
    name:'New Stage',
    desc:'Describe what happens at this stage.',
    color: colors[editorStages.length % colors.length],
    probability: 50, duration: 7,
    required:[], actions:[], automations:[],
    inspeq:false, approval:false, rotting:14,
  });
  renderEditorStages();
  selectStage(editorStages.length-1);
}

function removeStage(idx) {
  if(editorStages.length <= 2) { showToast('Pipeline needs at least 2 stages'); return; }
  editorStages.splice(idx, 1);
  if(selectedStageIdx === idx) clearStageDetail();
  else if(selectedStageIdx > idx) selectedStageIdx--;
  renderEditorStages();
}

