// ─────────────────────────────────────────────────────────────────
// PIPELINE ACTIONS
// ─────────────────────────────────────────────────────────────────
function duplicatePipeline(id) {
  const src = PIPELINES.find(p=>p.id===id);
  if(!src) return;
  const newId = 'PL'+(PIPELINES.length+1+Date.now()%100);
  PIPELINES.push({
    ...JSON.parse(JSON.stringify(src)),
    id: newId,
    name: src.name+' (Copy)',
    status: 'draft',
    isDefault: false,
    deals: 0, value: '$0',
  });
  renderPipelineCards();
  showToast('Pipeline "'+src.name+'" cloned as draft');
}

function toggleArchive(id) {
  const p = PIPELINES.find(x=>x.id===id);
  if(!p) return;
  p.status = p.status==='archived' ? 'active' : 'archived';
  renderPipelineCards();
  showToast(p.status==='archived' ? 'Pipeline archived' : 'Pipeline restored');
}

function setPipelineDefault(id) {
  const p = PIPELINES.find(x=>x.id===id);
  if(!p) return;
  PIPELINES.filter(x=>x.type===p.type).forEach(x=>x.isDefault=false);
  p.isDefault = true;
  renderPipelineCards();
  showToast('"'+p.name+'" set as default for '+p.type);
}

// ─────────────────────────────────────────────────────────────────
// PIPELINE EDITOR
// ─────────────────────────────────────────────────────────────────
function openPipelineEditor(id) {
  const p = PIPELINES.find(x=>x.id===id);
  if(!p) return;
  editingPipelineId = id;
  editorStages = p.stages.map(s => ({...s, required:[...s.required], actions:[...s.actions], automations:[...s.automations]}));
  selectedStageIdx = null;

  // Show editor tab
  const editorTab = document.getElementById('editor-tab');
  if(editorTab) editorTab.style.display='';

  switchPipelineView('editor', editorTab);

  // Populate header
  document.getElementById('editor-icon-display').textContent = p.icon;
  document.getElementById('pe-title').textContent = 'Editing: '+p.name;
  document.getElementById('pe-subtitle').textContent = p.type+' · '+p.persona+' · '+p.stages.length+' stages';
  document.getElementById('pe-name-input').value = p.name;
  document.getElementById('pe-status-select').value = p.status;
  document.getElementById('pe-default-check').checked = p.isDefault;
  document.getElementById('won-stage-label').textContent = p.wonStage;
  document.getElementById('lost-stage-label').textContent = p.lostStage;

  // Color picker
  const cp = document.getElementById('pe-color-picker');
  if(cp) cp.innerHTML = PALETTE.map(c=>`
    <div style="width:22px;height:22px;border-radius:50%;background:${c};cursor:pointer;border:2.5px solid ${c===p.color?'#fff':'transparent'};box-shadow:${c===p.color?'0 0 0 2px '+c:'none'};transition:all .12s"
      onclick="setPipelineColor('${c}',this)" title="${c}"></div>
  `).join('');

  // Required fields
  renderEditorRequiredFields(p.requiredFields);

  renderEditorStages();
  clearStageDetail();
}

function setPipelineColor(color, el) {
  document.querySelectorAll('#pe-color-picker div').forEach(d=>{
    d.style.border='2.5px solid transparent'; d.style.boxShadow='none';
  });
  el.style.border='2.5px solid #fff';
  el.style.boxShadow=`0 0 0 2px ${color}`;
  // update bar
  const p = PIPELINES.find(x=>x.id===editingPipelineId);
  if(p) p.color = color;
}

function renderEditorRequiredFields(fields) {
  const el = document.getElementById('pe-req-fields');
  if(!el) return;
  el.innerHTML = fields.map((f,i)=>`
    <div style="display:flex;align-items:center;gap:6px;padding:5px 8px;background:var(--surface);border:1px solid var(--border);border-radius:6px;font-size:12px">
      <span style="flex:1">${f}</span>
      <button onclick="removeRequiredField(${i})" style="background:none;border:none;cursor:pointer;color:var(--text3);font-size:14px;padding:0;line-height:1" onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--text3)'">×</button>
    </div>
  `).join('');
}

function removeRequiredField(idx) {
  const p = PIPELINES.find(x=>x.id===editingPipelineId);
  if(p) { p.requiredFields.splice(idx,1); renderEditorRequiredFields(p.requiredFields); }
}

function openAddFieldModal() { showToast('Add field picker — prototype'); }

// ─────────────────────────────────────────────────────────────────
// STAGE LIST RENDER (drag-to-reorder)
