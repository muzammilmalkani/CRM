function patchMachinesPage() {
  const grid = document.querySelector('#page-machines .machine-list-grid');
  if(!grid) return;
  const cards = grid.querySelectorAll('.machine-detail-card');
  const machineMap = {'C336XYZ123':'M1','C320TIN456':'M2','VOLVEC220456':'M3','KOM360PC789':'M4','DEERE310L321':'M5'};
  cards.forEach((card,i) => {
    const pinEl = card.querySelector('.mdc-pin');
    if(pinEl) {
      const pin = pinEl.textContent.replace('SN:','').trim().split('·')[0].trim();
      const id = machineMap[pin] || ('M'+(i+1));
      card.style.cursor = 'pointer';
      card.onclick = () => openMachineDetail(id);
    }
  });
}

// Also patch contact table rows
function patchContactTableRows() {
  setTimeout(()=>{
    const tbody = document.getElementById('contact-table-body');
    if(!tbody) return;
    const rows = tbody.querySelectorAll('tr');
    rows.forEach((row, i) => {
      if(CONTACTS[i]) {
        row.style.cursor = 'pointer';
        row.addEventListener('click', () => openContactDetail(CONTACTS[i].id));
      }
    });
  }, 200);
}

