function mdTab(tab, el) {
  ['overview','components','inspections','workorders','history','docs'].forEach(t=>{
    const e=document.getElementById('md-'+t); if(e) e.style.display='none';
  });
  const show=document.getElementById('md-'+tab);
  if(show) show.style.display=tab==='overview'?'flex':'block';
  document.querySelectorAll('#md-tabs .tab').forEach(t=>t.classList.remove('active'));
  if(el) el.classList.add('active');
  const id=window._currentMachineId||'M1';
  if(tab==='components') renderMachineComponents(id);
  if(tab==='inspections') renderMachineInspections(id);
  if(tab==='workorders') renderMachineWorkOrders(id);
  if(tab==='history') renderMachineHistory(id);
  if(tab==='docs') renderMachineDocs(id);
}

