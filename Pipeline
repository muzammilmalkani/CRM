function createFromTemplate(id) {
  const src = PIPELINES.find(p=>p.id===id);
  if(!src) return;
  document.getElementById('createPipelineModal').classList.remove('open');
  const newId = 'PL'+(PIPELINES.length+10+Date.now()%50);
  PIPELINES.push({
    ...JSON.parse(JSON.stringify(src)),
    id: newId,
    name: src.name+' (Copy)',
    status: 'draft',
    isDefault: false,
    deals: 0, value: '$0',
  });
  renderPipelineCards();
  setTimeout(()=>openPipelineEditor(newId), 50);
  showToast('New pipeline created from template');
}

