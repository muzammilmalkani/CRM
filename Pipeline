// ─────────────────────────────────────────────────────────────────
// VIEW SWITCHER
// ─────────────────────────────────────────────────────────────────
function switchPipelineView(view, tabEl) {
  ['list','editor','settings','permissions','analytics'].forEach(v => {
    const el = document.getElementById('pl-'+v);
    if(el) el.style.display = 'none';
  });
  const target = document.getElementById('pl-'+view);
  if(target) { target.style.display = 'flex'; target.style.flexDirection = 'column'; }
  document.querySelectorAll('#pipeline-tabs .tab').forEach(t => t.classList.remove('active'));
  if(tabEl) tabEl.classList.add('active');

  if(view === 'list')        renderPipelineCards();
  if(view === 'settings')    renderPipelineAdminSettings();
  if(view === 'permissions') renderPipelinePermissions();
  if(view === 'analytics')   renderPipelineAnalytics();
}

// ─────────────────────────────────────────────────────────────────
// FILTER + SEARCH
// ─────────────────────────────────────────────────────────────────
function filterPipelines(mode, btn) {
  filterMode = mode;
  document.querySelectorAll('.pl-filter-btn').forEach(b => b.classList.remove('pl-filter-active'));
  if(btn) btn.classList.add('pl-filter-active');
  renderPipelineCards();
}

function searchPipelines(q) {
  searchQuery = q.toLowerCase();
  renderPipelineCards();
}

function filterPipelinesByPersona() { showToast('Persona filter — prototype only'); }

// ─────────────────────────────────────────────────────────────────
// PIPELINE CARDS RENDER
// ─────────────────────────────────────────────────────────────────
function renderPipelineCards() {
  const grid = document.getElementById('pipeline-cards-grid');
  if(!grid) return;

  let list = PIPELINES;
  if(filterMode === 'active')  list = list.filter(p => p.status === 'active');
  if(filterMode === 'draft')   list = list.filter(p => p.status === 'draft');
  if(filterMode === 'archive') list = list.filter(p => p.status === 'archived');
  if(searchQuery) list = list.filter(p => p.name.toLowerCase().includes(searchQuery) || p.type.toLowerCase().includes(searchQuery));

  const badge = document.getElementById('pipe-count-badge');
  if(badge) badge.textContent = list.length + ' pipeline' + (list.length !== 1 ? 's' : '');

  if(!list.length) {
    grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--text3)">
      <div style="font-size:32px;margin-bottom:12px">🔍</div>
      <div style="font-size:14px;font-weight:500">No pipelines found</div>
      <div style="font-size:13px;margin-top:4px">Try adjusting your filters or <a style="color:var(--accent);cursor:pointer" onclick="openCreatePipeline()">create a new one</a>.</div>
    </div>`;
    return;
  }

  grid.innerHTML = list.map(p => renderPipelineCard(p)).join('');
}

function renderPipelineCard(p) {
  const statusStyle = {
    active:   ['#EAF3DE','#3B6D11','Active'],
    draft:    ['var(--amber-bg)','var(--amber)','Draft'],
    archived: ['var(--bg)','var(--text3)','Archived'],
  }[p.status] || ['var(--bg)','var(--text3)',p.status];

  return `
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow);transition:box-shadow .15s,transform .15s;cursor:pointer"
    onmouseover="this.style.boxShadow='var(--shadow-lg)';this.style.transform='translateY(-1px)'"
    onmouseout="this.style.boxShadow='var(--shadow)';this.style.transform=''"
    onclick="openPipelineEditor('${p.id}')">

    <!-- Colour bar + header -->
    <div style="height:5px;background:${p.color}"></div>
    <div style="padding:18px 20px 14px">
      <div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:12px">
        <div style="width:44px;height:44px;border-radius:10px;background:${p.color}18;border:1px solid ${p.color}33;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0">${p.icon}</div>
        <div style="flex:1;min-width:0">
          <div style="display:flex;align-items:center;gap:7px;margin-bottom:3px">
            <div style="font-size:15px;font-weight:700">${p.name}</div>
            ${p.isDefault ? `<span style="font-size:10px;padding:1px 7px;border-radius:20px;background:${p.color}22;color:${p.color};font-weight:700;border:1px solid ${p.color}33">Default</span>` : ''}
          </div>
          <div style="font-size:12px;color:var(--text3)">${p.type} &nbsp;·&nbsp; ${p.persona}</div>
        </div>
        <span style="font-size:11px;padding:2px 9px;border-radius:20px;background:${statusStyle[0]};color:${statusStyle[1]};font-weight:600;flex-shrink:0">${statusStyle[2]}</span>
      </div>

      <!-- Stage flow visualization -->
      <div style="margin-bottom:14px">
        <div style="display:flex;align-items:center;gap:0;position:relative">
          ${p.stages.map((s,i) => `
            <div style="flex:1;min-width:0;position:relative">
              <div style="display:flex;align-items:center">
                <div style="flex:1;height:6px;background:${s.color || p.color};opacity:${Math.max(0.25, 1 - i * 0.12)};border-radius:${i===0?'4px 0 0 4px':'0'}${i===p.stages.length-1?'0 4px 4px 0':''}" title="${s.name}"></div>
                ${i < p.stages.length-1 ? `<div style="width:1px;height:6px;background:#fff;opacity:.6"></div>` : ''}
