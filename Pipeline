        </div>
      </div>

      <!-- Metrics row -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px">
        ${[
          ['Stages',p.stages.length,''],
          ['Deals',p.deals,''],
          ['Win Rate',p.winRate+'%',p.winRate>60?'var(--accent2)':p.winRate>40?'var(--amber)':'var(--red)'],
          ['Value',p.value,'var(--text)'],
        ].map(([l,v,c])=>`
          <div style="text-align:center;padding:7px 4px;background:var(--surface2);border-radius:6px;border:1px solid var(--border)">
