                    <div style="width:8px;height:8px;border-radius:50%;background:${p.color};flex-shrink:0"></div>
                    <span style="font-size:13.5px;font-weight:500">${p.name}</span>
                    ${p.isDefault?`<span style="font-size:10px;padding:1px 6px;border-radius:20px;background:${p.color}18;color:${p.color}">default</span>`:''}
                  </div>
                </td>
                <td style="text-align:center;font-size:13.5px;font-weight:600">${p.deals}</td>
                <td style="text-align:center;font-family:'DM Mono',monospace;font-size:13px;font-weight:500">${p.value}</td>
                <td style="text-align:center">
                  <div style="display:flex;align-items:center;justify-content:center;gap:6px">
                    <div style="width:40px;height:5px;background:var(--border);border-radius:4px"><div style="height:5px;border-radius:4px;background:${wrCol};width:${wr}%"></div></div>
                    <span style="font-size:12.5px;font-weight:600;color:${wrCol}">${wr}%</span>
                  </div>
                </td>
                <td style="text-align:center;font-size:12.5px;color:var(--text2)">${p.stages.reduce((s,x)=>s+(x.duration||0),0)}d avg</td>
                <td style="text-align:center">
                  <span style="font-size:11.5px;padding:2px 8px;border-radius:20px;background:var(--amber-bg);color:var(--amber)">${bottleneck?.name||'—'}</span>
                </td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>
      </div>

      <!-- Stage conversion funnel -->
      <div class="dash-card" style="padding:20px 24px">
        <div style="font-size:13px;font-weight:600;margin-bottom:16px">Equipment Sales — Stage Conversion Funnel</div>
        <div style="display:flex;flex-direction:column;gap:8px">
          ${[
            {name:'Lead Captured',count:420,pct:100},
            {name:'Qualification',count:336,pct:80},
            {name:'Machine Matched',count:252,pct:60},
            {name:'Quote Sent',count:189,pct:45},
            {name:'Negotiation',count:126,pct:30},
            {name:'Inspection Required',count:96,pct:23},
            {name:'Financing',count:72,pct:17},
            {name:'Won',count:48,pct:11},
          ].map((s,i)=>`
            <div style="display:flex;align-items:center;gap:12px">
              <div style="width:140px;font-size:12.5px;color:var(--text2);text-align:right;flex-shrink:0">${s.name}</div>
              <div style="flex:1;height:24px;background:var(--bg);border-radius:4px;overflow:hidden">
                <div style="height:24px;background:linear-gradient(90deg,#2C7A4B,#4CAF78);width:${s.pct}%;border-radius:4px;opacity:${0.3+i*0.1};transition:width .4s ease;display:flex;align-items:center;padding-left:8px">
                  <span style="font-size:11px;font-weight:600;color:#fff;white-space:nowrap">${s.count} deals</span>
                </div>
              </div>
              <div style="width:40px;font-size:12px;font-weight:600;color:var(--text2);text-align:right">${s.pct}%</div>
            </div>
          `).join('')}
        </div>
      </div>
    </div>`;
}

function openGlobalPipelineSettings() {
  const el = document.getElementById('global-settings-body');
  if(el) el.innerHTML = `
    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="form-grid">
        <div class="form-group"><label class="form-label">Organisation Default Pipeline</label>
          <select class="form-select"><option>Equipment Sales</option>${PIPELINES.map(p=>`<option>${p.name}</option>`).join('')}</select>
        </div>
        <div class="form-group"><label class="form-label">Deal Value Currency</label>
          <select class="form-select"><option>USD</option><option>AUD</option><option>GBP</option><option>EUR</option></select>
        </div>
        <div class="form-group"><label class="form-label">Rotting Threshold (days)</label>
          <input type="number" class="form-input" value="14"></div>
        <div class="form-group"><label class="form-label">Margin Approval Threshold (%)</label>
          <input type="number" class="form-input" value="20"></div>
      </div>
      <div style="padding:14px;background:var(--accent-bg);border:1px solid rgba(44,122,75,0.2);border-radius:var(--radius);font-size:12.5px;color:var(--accent)">
        <strong>Tip:</strong> These settings apply globally. Individual pipeline overrides can be set in each pipeline's properties panel.
      </div>
    </div>`;
  document.getElementById('globalPipelineSettingsModal').classList.add('open');
}

function saveGlobalSettings() {
  document.getElementById('globalPipelineSettingsModal').classList.remove('open');
  showToast('Global pipeline settings saved');
}

