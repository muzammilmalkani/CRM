          `).join('')}
          <!-- Won terminal -->
          <div style="width:28px;height:6px;background:var(--accent2);border-radius:0 4px 4px 0;margin-left:2px" title="${p.wonStage}"></div>
        </div>
        <!-- Stage labels -->
        <div style="display:flex;gap:0;margin-top:5px;overflow:hidden">
          ${p.stages.slice(0,5).map((s,i) => `<div style="flex:1;min-width:0;font-size:9.5px;color:var(--text3);text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 1px">${s.name}</div>`).join('')}
